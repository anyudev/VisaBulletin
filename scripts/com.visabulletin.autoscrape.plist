<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent: run the visa-bulletin auto-scrape on days 10-20 of each month,
  twice daily (09:00 and 18:00 local time). launchd runs a missed job once on
  the next wake, so this is safe on a laptop that sleeps.

  Install:
    cp scripts/com.visabulletin.autoscrape.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.visabulletin.autoscrape.plist
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.visabulletin.autoscrape.plist
  Run once now (test):
    launchctl start com.visabulletin.autoscrape
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.visabulletin.autoscrape</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/yan/Work/git/VisaBulletin/scripts/auto-scrape.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Day</key><integer>10</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Day</key><integer>10</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Day</key><integer>11</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Day</key><integer>11</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Day</key><integer>12</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Day</key><integer>12</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Day</key><integer>13</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Day</key><integer>13</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
